{
  "name": "second-thought",
  "version": "1.0.0",
  "private": true,
  "description": "A wallet co-pilot that remembers your past money mistakes (Walrus Memory) and stops you before you repeat them, using live Sui data from Tatum.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "memories:preview": "tsx scripts/store-memories.ts",
    "memories:store": "tsx scripts/store-memories.ts --confirm",
    "memories:verify": "tsx scripts/verify-memories.ts",
    "check:tatum": "tsx scripts/check-tatum.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@mysten-incubation/memwal": "^0.1.9",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "framer-motion": "^14.6.0",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
