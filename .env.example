# Second Thought: copy to .env. NEVER commit .env. NEVER put a Sui wallet/owner private key here.

# "demo" runs with no keys: fixture wallet + the Walrus Memory SDK's in-memory mock.
# "live"  uses real Walrus Memory (mainnet) + real Tatum Sui RPC and refuses to start if a key is missing.
SECOND_THOUGHT_MODE=demo

# ── Walrus Memory (https://memory.walrus.xyz → create account + delegate key) ──
# The DELEGATE key (not your wallet key). It can write memories for the account and nothing else.
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=second-thought

# ── Tatum (https://dashboard.tatum.io → free API key) ──
TATUM_API_KEY=
TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# Public Sui address to watch (read-only; an address is not a secret)
WATCH_ADDRESS=

PORT=9010
